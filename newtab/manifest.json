{
  "manifest_version": 3,
  "name": "Sk/Ai Start",
  "version": "0.2.0",
  "description": "Privacy-focused start page with local Qwen assistant, tracker filtering and configurable search.",
  "permissions": ["declarativeNetRequest", "privacy", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "declarative_net_request": {"rule_resources": [{"id": "privacy_filters", "enabled": true, "path": "rules/privacy_filters.json"}]},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8765"
  },
  "chrome_url_overrides": {"newtab": "newtab.html"}
}