{
  "manifest_version": 3,
  "name": "Yandex Blind Start",
  "version": "0.3.0",
  "description": "Private start page with local Qwen assistant, configurable search and third-party tracker blocking.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "privacy_rules",
        "enabled": true,
        "path": "privacy-rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8765"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
